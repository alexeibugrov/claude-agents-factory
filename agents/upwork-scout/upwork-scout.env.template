# Template for upwork-scout's real secrets file on the VM.
#
# Copy this to `/app/upwork-scout/.env.upwork-scout` ON THE VM and fill it in. That file is
# gitignored, never committed, and never read by Claude — the harness denies it
# (.claude/settings.json). This template is committed precisely because it holds names, never values.

# Claude auth: the owner's SUBSCRIPTION, via a long-lived token from `claude setup-token`
# (run once on any machine with a browser). Renew by re-running that command — it does not
# auto-refresh. See kb/architecture/auth.md.
CLAUDE_CODE_OAUTH_TOKEN=

# MUST NOT be set. ANTHROPIC_API_KEY takes precedence over the token above and silently
# switches this agent to per-token API billing. The agent refuses to start if it is present.
# ANTHROPIC_API_KEY=

# Apify API token (console.apify.com → Settings → Integrations).
APIFY_TOKEN=

# Telegram API id/hash (my.telegram.org); the agent account's login is a session in ./telegram-session/.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Must equal POSTGRES_PASSWORD in .env.upwork-scout-db (the db container's file).
POSTGRES_PASSWORD=
