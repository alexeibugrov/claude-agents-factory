{
  "enabledMcpjsonServers": [
    "ssh-manager",
    "telegram"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/finalize-harvest-reminder.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__ssh-manager",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh cache list:*)",
      "Bash(uv lock:*)",
      "Bash(uv sync:*)",
      "Bash(uv tree:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pyright:*)",
      "Bash(yamllint:*)",
      "Bash(actionlint:*)",
      "Bash(zizmor:*)",
      "Bash(shellcheck:*)",
      "Bash(hadolint:*)",
      "Bash(gitleaks:*)",
      "Bash(semgrep:*)",
      "Bash(markdownlint-cli2:*)"
    ],
    "ask": [
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run delete:*)",
      "Bash(gh run download:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow enable:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(gh gist:*)",
      "Bash(gh auth:*)",
      "Bash(gh ssh-key:*)",
      "Bash(gh label:*)",
      "Bash(gh cache delete:*)",
      "Bash(docker:*)"
    ],
    "deny": [
      "mcp__telegram__add_chat_to_folder",
      "mcp__telegram__add_contact",
      "mcp__telegram__archive_chat",
      "mcp__telegram__ban_user",
      "mcp__telegram__block_user",
      "mcp__telegram__clear_draft",
      "mcp__telegram__create_channel",
      "mcp__telegram__create_folder",
      "mcp__telegram__create_group",
      "mcp__telegram__create_poll",
      "mcp__telegram__delete_chat_history",
      "mcp__telegram__delete_chat_photo",
      "mcp__telegram__delete_contact",
      "mcp__telegram__delete_folder",
      "mcp__telegram__delete_message",
      "mcp__telegram__delete_messages_bulk",
      "mcp__telegram__delete_profile_photo",
      "mcp__telegram__delete_scheduled_message",
      "mcp__telegram__demote_admin",
      "mcp__telegram__edit_admin_rights",
      "mcp__telegram__edit_chat_about",
      "mcp__telegram__edit_chat_photo",
      "mcp__telegram__edit_chat_title",
      "mcp__telegram__edit_message",
      "mcp__telegram__forward_message",
      "mcp__telegram__forward_messages",
      "mcp__telegram__import_chat_invite",
      "mcp__telegram__import_contacts",
      "mcp__telegram__invite_to_group",
      "mcp__telegram__join_chat_by_link",
      "mcp__telegram__leave_chat",
      "mcp__telegram__mark_as_read",
      "mcp__telegram__pin_message",
      "mcp__telegram__press_inline_button",
      "mcp__telegram__promote_admin",
      "mcp__telegram__remove_chat_from_folder",
      "mcp__telegram__remove_reaction",
      "mcp__telegram__reorder_folders",
      "mcp__telegram__reply_to_message",
      "mcp__telegram__save_draft",
      "mcp__telegram__send_album",
      "mcp__telegram__send_contact",
      "mcp__telegram__send_file",
      "mcp__telegram__send_gif",
      "mcp__telegram__send_message",
      "mcp__telegram__send_reaction",
      "mcp__telegram__send_scheduled_message",
      "mcp__telegram__send_sticker",
      "mcp__telegram__send_voice",
      "mcp__telegram__set_bot_commands",
      "mcp__telegram__set_default_chat_permissions",
